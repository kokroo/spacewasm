;; Regression test for the IrReader page-base-pointer cache.
;;
;; This module intentionally compiles to several IR TextPages (256 words each):
;;  - `sum_loop` has a padded loop body, so its back-edge (br $L) and forward
;;    exit (br_if $exit) jump ACROSS page boundaries every iteration.
;;  - `straight` is a long straight-line chain that crosses page boundaries
;;    during sequential decode/execution.
;; Together these exercise the reader cache's same-page hits, cross-page
;; misses, and jump-induced refills. Results are simple hand-checkable sums.

(module
  (func (export "sum_loop") (result i32)
    (local $acc i32)
    (local $i i32)
    (block $exit
      (loop $L
        (br_if $exit (i32.ge_s (local.get $i) (i32.const 1000)))
        (local.set $acc (i32.add (local.get $acc) (local.get $i)))
        ;; --- 120x identity padding (adds 0): bloats IR across pages ---
        (local.set $acc (i32.add (local.get $acc) (i32.const 0)))
        (local.set $acc (i32.add (local.get $acc) (i32.const 0)))
        (local.set $acc (i32.add (local.get $acc) (i32.const 0)))
        (local.set $acc (i32.add (local.get $acc) (i32.const 0)))
        (local.set $acc (i32.add (local.get $acc) (i32.const 0)))
        (local.set $acc (i32.add (local.get $acc) (i32.const 0)))
